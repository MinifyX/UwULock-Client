<?xml version="1.0" encoding="utf-8"?>
<!-- What UwULock offers Credential Manager (PasskeyProviderService): passkeys only. Passwords
     stay with the app and the browser extension. -->
<credential-provider xmlns:android="http://schemas.android.com/apk/res/android">
    <capabilities>
        <capability name="android.credentials.TYPE_PUBLIC_KEY_CREDENTIAL" />
    </capabilities>
</credential-provider>

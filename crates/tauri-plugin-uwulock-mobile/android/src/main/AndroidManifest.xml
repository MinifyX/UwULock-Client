<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Wi-Fi "Connect" on Android 10: network suggestions. A normal permission, granted at
         install; Android 11+ adds networks through the system's own sheet without it. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- Android 11+ hides other apps from UwULock: this lets it find the system's add-network
         sheet, so the password goes to that and nothing else (UwuLockMobilePlugin.connectWifi). -->
    <application>
        <!-- Passkeys for other apps and browsers through Credential Manager (Android 14+):
             PasskeyProviderService lists them, PasskeyActivity makes and signs. Switched on by
             the person in Settings → Passwords, passkeys and accounts. -->
        <service
            android:name="app.uwulock.mobile.PasskeyProviderService"
            android:enabled="@bool/uwulock_passkeys_enabled"
            android:exported="true"
            android:label="@string/uwulock_passkeys_label"
            android:permission="android.permission.BIND_CREDENTIAL_PROVIDER_SERVICE">
            <intent-filter>
                <action android:name="android.service.credentials.CredentialProviderService" />
            </intent-filter>
            <meta-data
                android:name="android.credentials.provider"
                android:resource="@xml/uwulock_passkey_provider" />
        </service>
        <activity
            android:name="app.uwulock.mobile.PasskeyActivity"
            android:enabled="@bool/uwulock_passkeys_enabled"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/UwULockPasskeyTheme" />
        <!-- Passwords for apps and browsers without Credential Manager: Android's autofill
             service. Suggestions carry no password; FillActivity verifies the person and fills.
             Switched on by the person (Settings, or UwULock's button: providerRequest). -->
        <service
            android:name="app.uwulock.mobile.UwuLockAutofillService"
            android:exported="true"
            android:label="@string/uwulock_passkeys_label"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/uwulock_autofill_service" />
        </service>
        <activity
            android:name="app.uwulock.mobile.FillActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/UwULockPasskeyTheme" />
    </application>
    <queries>
        <intent>
            <action android:name="android.settings.WIFI_ADD_NETWORKS" />
        </intent>
        <!-- Browsers: the autofill service checks a browser's certificate against the privileged
             list before it takes the page's domain as its address (LoginBridge.autofillCaller). -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>
</manifest>

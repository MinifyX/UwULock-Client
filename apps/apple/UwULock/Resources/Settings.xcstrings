          "stringUnit": {
            "state": "translated",
            "value": "Lock"
          }
        }
      }
    },
    "Sperrt UwULock, sobald der Bildschirm gesperrt wird oder der Computer in den Ruhezustand geht.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Locks UwULock as soon as the screen locks or the computer goes to sleep."
          }
        }
      }
    },
    "Sperrt UwULock, wenn es eine Minute oder länger im Hintergrund war.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Locks UwULock when it was in the background for a minute or longer."
          }
        }
      }
    },

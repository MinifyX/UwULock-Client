    "%@ Was schon im Tresor ist, bleibt dort; importiere den Rest nicht doppelt.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ What is in the vault already stays there; don't import it twice."
          }
        }
      }
    },
    "%@ als Datei speichern": {

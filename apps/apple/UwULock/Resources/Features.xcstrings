    "%@ nimmt dann für immer keine Mail mehr an und wird nie wieder vergeben. Zum Pausieren reicht „Abschalten“.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ will then never accept mail again and will never be handed out again. To pause it, “Switch off” is enough."
          }
        }
      }
    },
    "%@ speichern": {
      "extractionState": "manual",

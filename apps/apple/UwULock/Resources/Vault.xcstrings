    "Der Server hebt gelöschte Einträge 30 Tage auf, dann sind sie weg.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hebt gelöschte Einträge 30 Tage auf, dann sind sie weg."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server keeps deleted items for 30 days, then they are gone."
          }
        }
      }
    },

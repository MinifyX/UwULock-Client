    "Ein SSH-Schlüssel braucht alle drei Teile – privater Schlüssel, öffentlicher Schlüssel und Fingerprint. Der Server wirft den Eintrag sonst weg.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein SSH-Schlüssel braucht alle drei Teile – privater Schlüssel, öffentlicher Schlüssel und Fingerprint. Der Server wirft den Eintrag sonst weg."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An SSH key needs all three parts – private key, public key and fingerprint. The server drops the item otherwise."
          }
        }
      }
    },
    "Ein Teil dieses Eintrags ließ sich nicht entschlüsseln. Im Web-Tresor sieht er vielleicht anders aus.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Teil dieses Eintrags ließ sich nicht entschlüsseln. Im Web-Tresor sieht er vielleicht anders aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Part of this item couldn't be decrypted. It may look different in the web vault."
          }
        }
      }
    },

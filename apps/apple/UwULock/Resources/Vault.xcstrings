    "„%@“ verschwindet. Die Einträge darin bleiben – dann ohne Ordner.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ verschwindet. Die Einträge darin bleiben – dann ohne Ordner."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” goes. The items in it stay – without a folder."
          }
        }
      }
    },
    "„%@“ wandert in den Papierkorb. Der Server hebt ihn dort noch 30 Tage auf.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ wandert in den Papierkorb. Der Server hebt ihn dort noch 30 Tage auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” goes to the trash. The server keeps it there for another 30 days."
          }
        }
      }
    },
    "„%@“ wird auf dem Server gelöscht. Das lässt sich nicht rückgängig machen – auch nicht im Web-Tresor.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ wird auf dem Server gelöscht. Das lässt sich nicht rückgängig machen – auch nicht im Web-Tresor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” will be deleted on the server. This can't be undone – not in the web vault either."
          }
        }
      }
    },

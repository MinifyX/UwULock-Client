<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The app's own keys; Xcode adds the standard ones (GENERATE_INFOPLIST_FILE, project.yml).
     From apps/desktop/src-tauri/Info.ios.plist. -->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>de</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>de</string>
		<string>en</string>
	</array>
	<key>NSFaceIDUsageDescription</key>
	<string>UwULock opens your vault with Face ID instead of the master password.</string>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- Where the app leaves the sealed passkey list for the AutoFill extension, and the
	     Keychain group of the provider key (docs/passkeys.md). -->
	<key>UwULockAppGroup</key>
	<string>$(UWULOCK_APP_GROUP)</string>
	<key>UwULockKeychainGroup</key>
	<string>$(AppIdentifierPrefix)app.uwulock.passkeys</string>
	<!-- Apple Passwords' "Export data to another app" (credential exchange). -->
	<key>NSUserActivityTypes</key>
	<array>
		<string>ASCredentialExchangeActivityType</string>
	</array>
</dict>
</plist>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The disk image's app: not sandboxed (its data stays in ~/Library/Application Support/
     app.uwulock.desktop), the same groups as the Mac App Store's. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>
	<key>com.apple.developer.authentication-services.autofill-credential-provider</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(TeamIdentifierPrefix)app.uwulock</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(TeamIdentifierPrefix)app.uwulock</string>
		<string>$(TeamIdentifierPrefix)app.uwulock.passkeys</string>
		<string>$(TeamIdentifierPrefix)app.uwulock.unlock</string>
	</array>
</dict>
</plist>

    "Suche leeren": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear search"
          }
        }
      }
    },
    "UwULock braucht einen Gerätecode (und Face ID oder Touch ID, falls gesperrt: einmal mit dem Code entsperren).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "UwULock needs a device passcode (and if Face ID or Touch ID is locked out, unlock once with the passcode)."
          }
        }
      }
    },
    "UwULock fügt hier keinen Text ein. Tippe in ein Anmeldefeld und wähle dort UwULock.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "UwULock doesn't insert text here. Tap a sign-in field and pick UwULock there."
          }
        }
      }
    },
    "UwULock füllt keine Einmalcodes aus. Öffne UwULock und kopiere den Code dort.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "UwULock doesn't fill in one-time codes. Open UwULock and copy the code there."
          }
        }
      }
    },
    "UwULock-AutoFill": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "UwULock AutoFill"
          }
        }
      }
    },
    "UwULocks Passwörter und Passkeys für das System freigeben": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let the system list UwULock's passwords and passkeys"
          }
        }
      }
    },
    "Weitere Treffer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More results"

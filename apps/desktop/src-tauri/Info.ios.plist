<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged into the Info.plist that `tauri ios init` generates (scripts/ios-build.sh). -->
<plist version="1.0">
<dict>
	<!-- Shown by iOS the first time UwULock asks for Face ID, when unlocking with it is switched on. -->
	<key>NSFaceIDUsageDescription</key>
	<string>UwULock opens your vault with Face ID instead of the master password.</string>

	<!-- Files saved from a file request land in UwULock's own folder in the Files app. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>

	<!-- The AutoFill extension's shared places (passkeys/apple.rs, docs/passkeys.md): only there
	     in a build signed with an Apple developer team, with the matching entitlements. -->
	<key>UwULockAppGroup</key>
	<string>group.app.uwulock</string>
	<key>UwULockKeychainGroup</key>
	<string>$(AppIdentifierPrefix)app.uwulock.passkeys</string>

	<!-- iOS 26: Apple Passwords hands its data over with this activity (CredentialExchange.swift
	     in the mobile plugin). scripts/ios-build.sh adds the constant's value as the SDK has it. -->
	<key>NSUserActivityTypes</key>
	<array>
		<string>ASCredentialExchangeActivityType</string>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>de</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>de</string>
		<string>en</string>
	</array>
</dict>
</plist>

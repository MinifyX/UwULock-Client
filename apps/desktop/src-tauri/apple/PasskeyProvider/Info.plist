<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The AutoFill extension's Info.plist. iOS: Xcode fills in the $(…) values (scripts/ios-build.sh
     adds the target). macOS: scripts/macos-passkeys.sh fills them in itself. -->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>UwULock</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>UwULock</string>
	<key>CFBundlePackageType</key>
	<string>XPC!</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- Where the app leaves the sealed passkey list, and the Keychain group of the provider key.
	     Both only exist in a build signed with an Apple developer team (docs/passkeys.md). -->
	<key>UwULockAppGroup</key>
	<string>$(UWULOCK_APP_GROUP)</string>
	<key>UwULockKeychainGroup</key>
	<string>$(AppIdentifierPrefix)app.uwulock.passkeys</string>
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionAttributes</key>
		<dict>
			<key>ASCredentialProviderExtensionCapabilities</key>
			<dict>
				<key>ProvidesPasskeys</key>
				<true/>
				<key>ShowsConfigurationUI</key>
				<true/>
			</dict>
		</dict>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.authentication-services-credential-provider-ui</string>
		<key>NSExtensionPrincipalClass</key>
		<string>UwULockPasskeys.CredentialProviderViewController</string>
	</dict>
</dict>
</plist>

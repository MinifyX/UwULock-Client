{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UwULock",
  "version": "0.2.0-beta.1",
  "identifier": "app.uwulock.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "UwULock",
        "width": 1240,
        "height": 800,
        "minWidth": 860,
        "minHeight": 520,
        "center": true,
        "decorations": false,
        "shadow": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "freezePrototype": true
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFBMUZEMzQxQzk2OTlGMTQKUldRVW4ybkpRZE1mcWdUOHpHTkZSdGMvK3RWOEZ4LzZTdjduQ05rQUJtdXlnTm5QZUtwOHJzclQK",
      "endpoints": ["https://raw.githubusercontent.com/MinifyX/UwULock-Client/updates/beta.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "UwULock",
    "homepage": "https://github.com/MinifyX/UwULock-Client",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "GPL-3.0-only",
    "license": "GPL-3.0-only",
    "shortDescription": "Password manager for Vaultwarden and Bitwarden",
    "longDescription": "The password manager I build for myself, in the UwUSuite style: opens your Vaultwarden or Bitwarden vault with the same encryption as the official apps, and nothing leaves your device unencrypted.",
    "linux": {
      "deb": {
        "desktopTemplate": "linux/uwulock.desktop"
      },
      "rpm": {
        "desktopTemplate": "linux/uwulock.desktop"
      }
    }
  }
}

# One connection from UwULock to its uhid broker (uwulock-uhid-broker.socket). Root only to open
# /dev/uhid; no network, nothing writable but its lock files. Its one capability, CAP_SYS_PTRACE,
# only lets it read /proc/<pid>/exe of the program it serves or refuses (for the journal and for
# the "another program holds your key" warning); the broker drops it before it reads anything
# from the app.
[Unit]
Description=UwULock virtual security key for one connection
Documentation=https://github.com/MinifyX/UwULock-Client/blob/main/docs/passkeys.md
CollectMode=inactive-or-failed

[Service]
ExecStart=/usr/lib/uwulock/uwulock-uhid-broker
DevicePolicy=closed
DeviceAllow=/dev/uhid rw
CapabilityBoundingSet=CAP_SYS_PTRACE
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/run/uwulock
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
ProtectProc=default
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077

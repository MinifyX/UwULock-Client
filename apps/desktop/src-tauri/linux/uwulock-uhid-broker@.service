# One connection from UwULock to its uhid broker (uwulock-uhid-broker.socket). Root only to open
# /dev/uhid; no capabilities, no network, nothing writable but its lock files.
[Unit]
Description=UwULock virtual security key for one connection
Documentation=https://github.com/MinifyX/UwULock-Client/blob/main/docs/passkeys.md
CollectMode=inactive-or-failed

[Service]
ExecStart=/usr/lib/uwulock/uwulock-uhid-broker
DevicePolicy=closed
DeviceAllow=/dev/uhid rw
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/run/uwulock
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077
